clc
clear all
close all

%% load filtered exercise table
exercise = load("exerciseTable_filtered.mat").exerciseTable_clean;
exercise(exercise.DurationValue < 15, :) = [];

base_path = '/Users/albertogastaldello/Desktop/LOOP_Data/Loop study public dataset 2023-01-31';
subjectsStruct = load("dataTablesStructure_withDateTime.mat").data_tables_all;

% Outcomes to compute
outcomeNames = ["ExcursionDuringActivity", "RoCDuringActivity", "HypoglycemiaEvent", ...
                "SevereHypoglycemiaEvent", "NocturnalTIR", "NocturnalHypoglycemiaEvent"];

% -------------------------
% Initialize valid exercise table with same variables as original
% -------------------------
exercise_valid = exercise([],:);  % empty table with same vars
exercise_valid.insulinInfo = {};  % cell for insulin structs
exercise_valid.cgmInfo     = {};  % cell for CGM structs

subjectsID = unique(exercise.PtID);


%% Loop over subjects

for i = 1:length(subjectsID)

    disp(i);

    curr_subjID = subjectsID(i);
    struct_patientField = ['patient_' num2str(curr_subjID)];
    curr_exercise = exercise(exercise.PtID == curr_subjID,:);

    % Load subject CGM, basal, bolus
    cgm_path   = fullfile(base_path, ['data_type=cgm/patient_id=' num2str(curr_subjID)], 'cgm.csv');
    basal_path = fullfile(base_path, ['data_type=basal/patient_id=' num2str(curr_subjID)], 'basal.csv');
    bolus_path = fullfile(base_path, ['data_type=bolus/patient_id=' num2str(curr_subjID)], 'bolus.csv');

    cgm_data   = readtable(cgm_path);
    basal_data = readtable(basal_path);
    bolus_data = readtable(bolus_path);

    % Wizard info
    curr_wizard = subjectsStruct.(struct_patientField).wizard;
    curr_wizard = sortrows(curr_wizard, 'DeviceDtTm');

    curr_subjectMealData = subjectsStruct.(struct_patientField).food;
    mealColumsToKeep = ["PtID", ""]

    % -------------------------
    % Loop over sessions
    % -------------------------
    for j = 1:height(curr_exercise)
        curr_session = curr_exercise(j,:);

        % get CGM data
        [cgmPreExercise_table, cgmExercise_table, cgmPostExercise_table, isValidSession] = ...
            getCgmData(curr_session, cgm_data);

        if ~isValidSession
            continue
        end

        % Add CGM data
        tmpCgm = struct();

        tmpCgm.cgmPreExercise  = cgmPreExercise_table;
        tmpCgm.cgmExercise     = cgmExercise_table;
        tmpCgm.cgmPostExercise = cgmPostExercise_table;

        % Get Insulin Data
        [curr_CF, curr_CR, curr_tslb, curr_lb, curr_tslBasal, curr_lBasal, curr_IOB] = ...
            getInsulinInfo(curr_session, curr_wizard, bolus_data, basal_data);
        
        % Add insulin data
        tmpInsulin = struct(...
            'InsSensitivity', curr_CF, ...
            'InsCarbRatio', curr_CR, ...
            'TimeSinceLastBolus', curr_tslb, ...
            'LastBolus', curr_lb, ...
            'TimeSinceLastBasal', curr_tslBasal, ...
            'LastBasal', curr_lBasal, ...
            'IOB', curr_IOB ...
        );

        % get meal data
        

        curr_sessionMealData = getMealData(curr_session, )

        curr_session.cgmInfo     = struct();
        curr_session.insulinInfo = struct();

        % Append session to valid table
        exercise_valid = [exercise_valid; curr_session];  % safe now
        exercise_valid.cgmInfo{end}     = tmpCgm;
        exercise_valid.insulinInfo{end} = tmpInsulin;
    end
end

%% Functions

% getInsulinInfo

function [CF, CR, tslb, lb, tslBasal, lBasal, IOB] = getInsulinInfo(session, wizard, bolus_data, basal_data)
    CF=NaN; CR=NaN; tslb=NaN; lb=NaN; tslBasal=NaN; lBasal=NaN; IOB=NaN;

    maxTolerance = minutes(30);
    startExercise = session.DeviceDtTm;

    % Wizard CF and CR
    idx = find(wizard.DeviceDtTm <= startExercise, 1, 'last');
    if ~isempty(idx)
        CF = wizard.InsulinSensitivity(idx);
        CR = wizard.InsulinCarbRatio(idx);
        if startExercise - wizard.DeviceDtTm(idx) <= maxTolerance
            IOB = wizard.InsulinOnBoard(idx);
        end
    end

    % Last bolus info
    boluses_before = bolus_data.datetime_aligned(bolus_data.datetime_aligned <= startExercise);
    idx_bolus = find(bolus_data.datetime_aligned <= startExercise, 1, 'last');
    if ~isempty(boluses_before)
        tslb = minutes(startExercise - max(boluses_before));
        lb = bolus_data.bolus(idx_bolus);
    end

    % Last basal info
    basal_before = basal_data.datetime_aligned(basal_data.datetime_aligned <= startExercise);
    idx_basal = find(basal_data.datetime_aligned <= startExercise, 1, 'last');
    if ~isempty(basal_before)
        tslBasal = minutes(startExercise - max(basal_before));
        lBasal = basal_data.basal_rate(idx_basal);
    end
end

% getOutcomes

function [cgmPreExercise_table, cgmExercise_table, cgmPostExercise_table, isValidSession] = ...
         getCgmData(session, cgm)

    isValidSession = true;

    startExercise = session.DeviceDtTm;
    endExercise   = startExercise + minutes(session.DurationValue);

    preExercise  = startExercise - hours(2);
    postExercise = endExercise + hours(6);

    % -------------------------
    % Aggregate duplicate timestamps by mean
    % -------------------------
    [uniqueTimes, ~, ic] = unique(cgm.datetime);
    cgm_agg = accumarray(ic, cgm.cgm, [], @mean);
    
    % safe vectors for interp1
    cgmTimes = datenum(uniqueTimes);
    cgmValues = cgm_agg;

    % Interpolate CGM
    glucoseStart = interp1(cgmTimes, cgmValues, datenum(startExercise), 'linear', 'extrap');
    glucoseEnd   = interp1(cgmTimes, cgmValues, datenum(endExercise), 'linear', 'extrap');

    % CGM windows
    idxExercise = cgm.datetime >= startExercise & cgm.datetime <= endExercise;
    idxPre      = cgm.datetime >= preExercise & cgm.datetime <= startExercise;
    idxPost     = cgm.datetime >= endExercise & cgm.datetime <= postExercise;

    cgmExercise_table     = timetable(cgm.datetime(idxExercise), cgm.cgm(idxExercise), 'VariableNames', {'Glucose'});
    cgmPreExercise_table  = timetable(cgm.datetime(idxPre), cgm.cgm(idxPre), 'VariableNames', {'Glucose'});
    cgmPostExercise_table = timetable(cgm.datetime(idxPost), cgm.cgm(idxPost), 'VariableNames', {'Glucose'});

    % minimum number of points
    expectedPrePoints  = 120/5;  % 2h with 5min sampling
    expectedPostPoints = 360/5;  % 6h with 5min sampling
    minPrePoints  = 0.85 * expectedPrePoints;
    minPostPoints = 0.85 * expectedPostPoints;

    if height(cgmPreExercise_table) < minPrePoints || ...
       height(cgmExercise_table) < 3 || ...
       height(cgmPostExercise_table) < minPostPoints
        isValidSession = false;
        return
    end
end

